{
  "name": "solana-wallet-extension",
  "version": "0.2.0",
  "description": "Cinder Wallet — a Solana wallet browser extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "pnpm build && pnpm build:content && pnpm build:injected && pnpm copy:manifest",
    "build:content": "vite build --config vite.content.config.ts",
    "build:injected": "vite build --config vite.injected.config.ts",
    "copy:manifest": "cp manifest.json \"${CINDER_OUT_DIR:-dist}/\" && node scripts/sync-version.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "@solana/spl-token": "^0.4.0",
    "@solana/wallet-standard-chains": "^1.1.1",
    "@solana/wallet-standard-features": "^1.3.0",
    "@solana/web3.js": "^1.98.0",
    "@tanstack/react-query": "^5.74.4",
    "@types/qrcode": "^1.5.5",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "@wallet-standard/wallet": "^1.1.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "ed25519-hd-key": "^1.3.0",
    "framer-motion": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^9.2.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.315",
    "@types/node": "^22.14.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^1.2.0"
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808"
}
