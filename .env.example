# Cluster for the built extension and test dApp. Use devnet for local/e2e.
VITE_NETWORK=devnet

# Optional. When set, Helius is tried first; 408 / 429 / 5xx / network errors
# rotate to the public Solana RPC for that cluster. DAS stays on Helius.
# Never commit a real key.
VITE_HELIUS_API_KEY=

# Pinata — used only by mint scripts / mplx. Do not import these from src/
# or they will be baked into the extension bundle.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
# Accepted as aliases if you already set these names:
# VITE_PINATA_JWT=
# VITE_PINATA_API_KEY=
# VITE_PINATA_API_SECRET=
