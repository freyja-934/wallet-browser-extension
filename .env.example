# Cluster for the built extension and test dApp. Use devnet for local/e2e.
VITE_NETWORK=devnet

# Optional. Public Solana RPC is the default. On devnet this hits devnet.helius-rpc.com.
VITE_HELIUS_API_KEY=

# Pinata — used only by mint scripts / mplx. Do not import these from src/
# or they will be baked into the extension bundle.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
# Accepted as aliases if you already set these names:
# VITE_PINATA_JWT=
# VITE_PINATA_API_KEY=
# VITE_PINATA_API_SECRET=
